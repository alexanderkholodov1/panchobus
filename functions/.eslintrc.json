{
  "root": true,
  "env": {
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "google",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2020
  },
  "ignorePatterns": [
    "/lib/**/*",
    "/node_modules/**/*"
  ],
  "plugins": [
    "import",
    "@typescript-eslint"
  ],
  "rules": {
    "import/no-unresolved": 0,
    "indent": [
      "error",
      2
    ],
    "object-curly-spacing": [
      "error",
      "always"
    ],
    "operator-linebreak": [
      "error",
      "after"
    ],
    "require-jsdoc": 0,
    "linebreak-style": 0
  }
}
