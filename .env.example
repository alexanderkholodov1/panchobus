# Supabase (requerido para auth real y persistencia)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Modo demo: si DEMO_MODE=true, el login simulado está activo y se usan datos locales
NEXT_PUBLIC_DEMO_MODE=true

# Gemini API (free tier en ai.google.dev). Solo necesario para Insights IA
GEMINI_API_KEY=your-gemini-api-key

# Secret para firmar QR codes (cualquier string largo aleatorio)
QR_SIGNING_SECRET=change-me-to-something-very-random-and-long
